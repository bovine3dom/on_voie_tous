{
  "manifest_version": 3,
  "name": "On Voie Tous",
  "version": "0.13",
  "permissions": [],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "icons": {
    "32": "logo_32.png",
    "64": "logo_64.png"
  },
  "host_permissions": [
    "https://www.garesetconnexions.sncf/*",
    "https://iechub.rfi.it/ArriviPartenze/*",
    "https://pantallas-estaciones.vercel.app/*",
    "https://www.adif.es/w/*",
    "https://www.b-europe.com/*",
    "https://dpartu.re/*",
    "https://compute.olie.science/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "on_voie_tous@bovine3dom",
      "data_collection_permissions": {"required": ["none"]}
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.adif.es/w/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.garesetconnexions.sncf/*",
        "https://iechub.rfi.it/ArriviPartenze/ArrivalsDepartures/Monitor*",
        "https://pantallas-estaciones.vercel.app/*",
        "https://www.adif.es/w/*",
        "https://www.b-europe.com/EN/Real-time*",
        "https://dpartu.re/*"
      ],
      "js": ["content.user.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
